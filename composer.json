{
    "name": "tomaj/meta-scraper",
    "description": "Page meta scraper library",
    "license": "MIT",
    "keywords": [
        "page",
        "sraper",
        "meta"
    ],
    "authors": [
        {
            "name": "Tomas Majer",
            "email": "tomasmajer@gmail.com",
            "homepage": "http://www.tomaj.sk/"
        }
    ],
    "support": {
        "issues": "https://github.com/tomaj/meta-scraper/issues",
        "source": "https://github.com/tomaj/meta-scraper"
    },
    "require": {
        "php": "^8.3",
        "guzzlehttp/guzzle": "^7.9"
    },
    "suggest": {
        "ext-dom": "Required for Tomaj\\Scraper\\Parser\\OgDomParser",
        "ext-libxml": "Required for Tomaj\\Scraper\\Parser\\OgDomParser"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.90",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.1",
        "phpunit/phpunit": "^12.5 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "Tomaj\\Scraper\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tomaj\\Scraper\\Test\\": "tests"
        }
    },
    "scripts": {
        "check": [
            "@phpcs",
            "@phpstan",
            "@test"
        ],
        "cs-fix": "php-cs-fixer fix",
        "phpcs": "php-cs-fixer fix --dry-run --diff --verbose",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "phpunit": [
            "@putenv XDEBUG_MODE=off",
            "phpunit --no-coverage"
        ],
        "test": "@phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
